{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "links",
  "compatibility_date": "2026-09-17",
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "PUZZLES",
      "id": "d496312f0f8b4e97ac94d969c72bd2a7"
    }
  ],
  "observability": {
    "enabled": true
  }
}
